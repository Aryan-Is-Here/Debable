# Copy to backend/.env and fill in. Never commit the real .env.

# --- Runtime ---
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Async driver (psycopg3). Matches docker/docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://debable:debable@localhost:5432/debable

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- LiveKit (video) ---
# From the LiveKit Cloud dashboard: the project URL is on the project page, the key and
# secret are under Settings -> Keys. The URL is public; the secret is a signing key and
# belongs only here — never in the frontend, never in a commit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Anthropic (AI fact-check) ---
# From https://console.anthropic.com -> API keys. This is a spending credential: every
# fact-check costs money, so it belongs here and never in the frontend.
ANTHROPIC_API_KEY=
# Model used to evaluate a claim.
ANTHROPIC_MODEL=claude-opus-5
# The trust boundary for the fact-check: web search is restricted to these domains, so a
# citation can only come from a source on this list. Comma-separated; keep it in step with
# app/core/sources.py.
FACT_CHECK_ALLOWED_DOMAINS=reuters.com,apnews.com,bbc.co.uk,nature.com,science.org,who.int,bls.gov,census.gov,nih.gov,cdc.gov,worldbank.org,imf.org,oecd.org,un.org,europa.eu
# Hard ceiling on how long one fact-check may take before it is reported as unavailable.
FACT_CHECK_TIMEOUT_SECONDS=60

# --- Clerk (auth) ---
# Issuer URL from the Clerk dashboard, e.g. https://your-app-12.clerk.accounts.dev
# JWKS URL defaults to <issuer>/.well-known/jwks.json when left blank.
CLERK_ISSUER=
CLERK_JWKS_URL=
# Optional: expected `aud` claim. Leave blank to skip audience verification.
CLERK_AUDIENCE=
# Optional: comma-separated authorized parties checked against the `azp` claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Seconds to cache the fetched JWKS before refetching.
CLERK_JWKS_CACHE_SECONDS=3600
