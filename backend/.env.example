# Copy to backend/.env and fill in. Never commit the real .env.

# --- Runtime ---
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Async driver (psycopg3). Matches docker/docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://debable:debable@localhost:5432/debable

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- LiveKit (video) ---
# From the LiveKit Cloud dashboard: the project URL is on the project page, the key and
# secret are under Settings -> Keys. The URL is public; the secret is a signing key and
# belongs only here — never in the frontend, never in a commit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini (AI fact-check) ---
# Free key from https://aistudio.google.com/apikey — no card required.
# Leave blank and the app runs on a deterministic stub provider: the debate room works end
# to end on a fresh clone, the fact-check answers are just fake.
#
# Do NOT enable billing on the Google project. The free tier is not a floor you keep — it
# disappears entirely the moment billing is attached.
GEMINI_API_KEY=
# Gemini 2.5 Flash is the only model whose Google Search grounding is free of charge (up to
# 500 grounded requests/day). Every 3.x model lists grounding as "not available" on the free
# tier, so this is a constraint rather than a preference.
GEMINI_MODEL=gemini-2.5-flash
# Requests per debate room per hour — stops one debate spamming the button.
FACT_CHECK_RATE_LIMIT_PER_HOUR=10
# Requests across the whole deployment per day. The per-room limit cannot protect a shared
# quota: thirty rooms at ten checks each is 300, and on a 250/day free tier everything after
# that fails for everyone. Keep this below your real quota, which you can check at
# https://aistudio.google.com/rate-limit — the free generation limit can bind long before
# the 500/day grounding limit does.
FACT_CHECK_DAILY_BUDGET=200
# How long one fact-check may take before it is reported as unavailable.
FACT_CHECK_TIMEOUT_SECONDS=45

# --- Clerk (auth) ---
# Issuer URL from the Clerk dashboard, e.g. https://your-app-12.clerk.accounts.dev
# JWKS URL defaults to <issuer>/.well-known/jwks.json when left blank.
CLERK_ISSUER=
CLERK_JWKS_URL=
# Optional: expected `aud` claim. Leave blank to skip audience verification.
CLERK_AUDIENCE=
# Optional: comma-separated authorized parties checked against the `azp` claim.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Seconds to cache the fetched JWKS before refetching.
CLERK_JWKS_CACHE_SECONDS=3600
